menuconfig REMOTE
	bool "Remote drivers"
	help
	  Include remote drivers in the system configuration.

if REMOTE

module = REMOTE
module-str = Remote
source "subsys/logging/Kconfig.template.log_config"

# 协议选择。choice 里的成员 config 不能跨文件 source，所以两个驱动的
# symbol 直接写在这里，不再拆 Kconfig.DT7 / Kconfig.VT13——拆了就得在主
# 文件里另抄一份 choice 成员，两边容易走散。
#
# 注意 DTS 与 Kconfig 是单向关系：Kconfig 能读 DT_HAS_*_ENABLED，反之不行。
# DT_HAS_RP_VT13_REMOTE_ENABLED 这类符号由 dts/bindings/ 下的 yaml 生成，
# 其取值再由最终 DTS 里有没有对应的 status="okay" 节点决定。

choice REMOTE_PROTOCOL
    prompt "Remote protocol"
    default REMOTE_PROTOCOL_DT7
    help
      Which remote controller protocol to build in. Exactly one driver is
      compiled; switch without adding a build directory, e.g.:

        west build -d build -- -DCONFIG_REMOTE_PROTOCOL_VT13=y \
                               -DCONFIG_REMOTE_PROTOCOL_DT7=n

      Both options must be spelled out: Zephyr caches every CONFIG_* passed
      on the command line and replays it on later invocations, so leaving
      the old one out silently keeps the old protocol selected.

      An option whose devicetree node is missing or disabled cannot be
      selected, so the choice falls back to the other one rather than
      silently building nothing.

config REMOTE_PROTOCOL_DT7
    bool "DT7 (DBUS, 100000 8E1, 18-byte frame)"
    depends on DT_HAS_RP_DT7_REMOTE_ENABLED

config REMOTE_PROTOCOL_VT13
    bool "VT13 / VT03 (921600 8N1, 21-byte frame)"
    depends on DT_HAS_RP_VT13_REMOTE_ENABLED

endchoice

config DT7_REMOTE
    bool
    default y if REMOTE_PROTOCOL_DT7
    help
      DJI DT7 remote controller, DBUS protocol (normally through a DR16
      receiver). Selected by REMOTE_PROTOCOL_DT7; requires a devicetree
      node with compatible = "rp,dt7-remote".

config VT13_REMOTE
    bool
    default y if REMOTE_PROTOCOL_VT13
    help
      DJI VT13/VT03 image transmission remote controller. Selected by
      REMOTE_PROTOCOL_VT13; requires a devicetree node with
      compatible = "rp,vt13-remote".

config REMOTE_INIT_PRIORITY
    int "Remote init priority"
    default 80
    range 0 99
    depends on DT7_REMOTE || VT13_REMOTE
    help
      Device init priority at POST_KERNEL stage.

# rc_thread.c 的两项线程参数（栈大小 / 优先级）不在这里，它们属于应用侧：
# 解析线程由应用自己建，配置项跟着实现走，见 samples/boards/dm_mc02/remote/Kconfig。

endif # REMOTE
